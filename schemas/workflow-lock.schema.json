{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planning-with-files/workflow-lock.schema.json",
  "type": "object",
  "required": ["lock_schema_version", "lock_owner", "agent_id", "process_id", "host_name", "created_at", "heartbeat_at", "target_file", "base_digest"],
  "properties": {
    "lock_schema_version": {"const": 1},
    "process_id": {"type": "integer"},
    "created_at": {"type": "string", "format": "date-time"},
    "heartbeat_at": {"type": "string", "format": "date-time"},
    "base_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
